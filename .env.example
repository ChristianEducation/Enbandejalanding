# ── Base de datos (Supabase / Postgres) ─────────────────────────────
# Conexión runtime vía transaction pooler (puerto 6543, apto para
# serverless en Vercel). Usa el rol dedicado `landing_writer`
# (permisos mínimos: solo insert/select en la tabla leads).
DATABASE_URL="postgresql://landing_writer.<PROJECT_REF>:<PASSWORD>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexión directa (session pooler, puerto 5432) — solo la usa Prisma
# para migraciones/introspección, no la app en runtime.
DIRECT_URL="postgresql://landing_writer.<PROJECT_REF>:<PASSWORD>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# ── Contacto visible en la página ───────────────────────────────────
# Correo institucional que se muestra junto al formulario y en el
# footer. Si se deja vacío, simplemente no se muestra (nunca hay un
# dominio de ejemplo hardcodeado en el código).
NEXT_PUBLIC_CONTACT_EMAIL=""

# URL pública del sitio (para OG tags / metadata). Ej: https://enbandeja.app
NEXT_PUBLIC_SITE_URL=""

# ── Notificación de lead nuevo por correo (opcional, vía Resend) ────
# Si RESEND_API_KEY o NOTIFY_EMAIL_TO están vacíos, la notificación se
# omite silenciosamente — el guardado en base de datos NO depende de esto.
RESEND_API_KEY=""
NOTIFY_EMAIL_TO=""
# Remitente. Mientras no verifiques tu dominio en Resend puedes usar
# el sandbox oficial: "EnBandeja <onboarding@resend.dev>"
NOTIFY_EMAIL_FROM=""

# ── Anti-spam ────────────────────────────────────────────────────────
# Sal para hashear la IP antes de guardarla (rate limiting). Cualquier
# string aleatorio largo.
IP_HASH_SALT=""
