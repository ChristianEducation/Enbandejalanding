// Esquema Prisma para la landing de EnBandeja.
// La tabla `leads` ya existe en Supabase (creada por migración
// `create_leads_table`) — este esquema la mapea, no la crea.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lead {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  nombre           String
  empresa          String
  email            String
  whatsapp         String
  cantidadColegios Int      @default(1) @map("cantidad_colegios")
  tieneCafeteria   Boolean  @default(false) @map("tiene_cafeteria")
  mensaje          String?
  origen           String   @default("landing-enbandeja")
  estado           String   @default("nuevo")
  ipHash           String?  @map("ip_hash")
  utmJson          Json?    @map("utm_json")

  @@index([email, createdAt(sort: Desc)], map: "leads_email_created_at_idx")
  @@index([ipHash, createdAt(sort: Desc)], map: "leads_ip_hash_created_at_idx")
  @@map("leads")
}
